# Google Drive Audit API Configuration

# Directory where CSV audit reports will be stored
DOWNLOAD_DIR=./downloads

# Path to Google Service Account JSON file
SERVICE_ACCOUNT_FILE=./drive-audit-service.json

# Bearer token for API authentication (optional but recommended)
API_BEARER_TOKEN=your-secure-bearer-token-here

# External base URL for download links (optional)
# If not set, will use the request host
EXTERNAL_BASE_URL=https://your-domain.com

# Logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO